<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBF0"
    android:padding="16dp">

    <TextView
        android:id="@+id/select_game_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="Select a Game"
        android:textColor="#555555"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/select_game_title" />

    <!-- Math Quiz Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/math_quiz_card"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/card_background"
        android:elevation="4dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <ImageView
            android:id="@+id/math_icon"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_menu_edit"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#FF5722" />

        <TextView
            android:id="@+id/math_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-black"
            android:text="Math Quiz"
            android:textColor="#555555"
            android:textSize="22sp"
            app:layout_constraintStart_toEndOf="@id/math_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/math_play_button"
            app:layout_constraintVertical_chainStyle="packed" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/math_play_button"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_orange"
            android:text="Play"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/math_title"
            app:layout_constraintTop_toBottomOf="@id/math_title"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Word Adventure Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/word_adventure_card"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/card_background"
        android:elevation="4dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/math_quiz_card">

        <ImageView
            android:id="@+id/word_icon"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_menu_sort_alphabetically"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#4CAF50" />

        <TextView
            android:id="@+id/word_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-black"
            android:text="Word Adventure"
            android:textColor="#555555"
            android:textSize="22sp"
            app:layout_constraintStart_toEndOf="@id/word_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/word_play_button"
            app:layout_constraintVertical_chainStyle="packed" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/word_play_button"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_orange"
            android:text="Play"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/word_title"
            app:layout_constraintTop_toBottomOf="@id/word_title"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Shape Sorter Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shape_sorter_card"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/card_background"
        android:elevation="4dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/word_adventure_card">

        <ImageView
            android:id="@+id/shape_icon"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_menu_gallery"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#2196F3" />

        <TextView
            android:id="@+id/shape_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-black"
            android:text="Shape Sorter"
            android:textColor="#555555"
            android:textSize="22sp"
            app:layout_constraintStart_toEndOf="@id/shape_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/shape_play_button"
            app:layout_constraintVertical_chainStyle="packed" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/shape_play_button"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_orange"
            android:text="Play"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/shape_title"
            app:layout_constraintTop_toBottomOf="@id/shape_title"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Back Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/back_button"
        android:layout_width="160dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_dark_grey"
        android:drawablePadding="8dp"
        android:paddingStart="16dp"
        android:text="Back"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>